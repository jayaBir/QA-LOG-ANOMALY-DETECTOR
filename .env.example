APP_ENV=dev
USE_S3=false

# Local Python runs prefer this MLflow server when it is available.
DEFAULT_MLFLOW_SERVER_URI=http://localhost:5000

# Docker Compose services use http://mlflow:5000 internally.
# Set this manually for local Python runs only when you want to force a backend.
# MLFLOW_TRACKING_URI=http://localhost:5000

MLFLOW_BACKEND_STORE_URI=sqlite:////mlflow/mlflow.db
MLFLOW_ARTIFACT_ROOT=/mlruns
MLFLOW_EXPERIMENT_NAME=qa-log-anomaly-detector
MLFLOW_REGISTERED_MODEL_NAME=qa-log-anomaly-detector
MLFLOW_MODEL_URI=

AWS_DEFAULT_REGION=ap-southeast-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
